generator client {
  provider     = "prisma-client"
  output       = "../../apps/backend/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum FonteDadosTipo {
  API
  CSV
  XLSX
  MANUAL
  WEBSERVICE
  PUBLIC_DATA
  OUTRO

  @@map("fonte_dados_tipo")
}

enum ImportacaoStatus {
  PENDENTE
  VALIDANDO
  PRONTA
  PROCESSANDO
  CONCLUIDA
  CONCLUIDA_COM_ERROS
  FALHOU

  @@map("importacao_status")
}

enum ImportacaoTipo {
  ADMINISTRADORAS
  PRODUTOS
  GRUPOS
  COTAS
  ASSEMBLEIAS
  LANCES
  CONTEMPLACOES
  TABELAS_COMERCIAIS

  @@map("importacao_tipo")
}

enum TabelaComercialStatus {
  ATIVA
  INATIVA
  ENCERRADA

  @@map("tabela_comercial_status")
}

enum ModalidadeComercial {
  NORMAL
  MAIS_POR_MENOS
  OUTRA

  @@map("modalidade_comercial")
}

enum TabelaComercialOrigem {
  MANUAL
  IMPORTACAO
  INTEGRACAO

  @@map("tabela_comercial_origem")
}

enum ImportacaoEstrategia {
  IGNORAR
  ATUALIZAR

  @@map("importacao_estrategia")
}

enum ArquivoClassificacao {
  COMMERCIAL_TABLE
  GROUP_PORTFOLIO
  QUOTA_PORTFOLIO
  ASSEMBLY_HISTORY
  MIXED

  @@map("arquivo_classificacao")
}

enum DataQualitySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL

  @@map("data_quality_severity")
}

enum DataQualityStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  IGNORED

  @@map("data_quality_status")
}

enum DataQualityOrigin {
  IMPORTACAO
  VALIDACAO_INTERNA
  PROCESSAMENTO
  INTEGRACAO_FUTURA
  AUDITORIA_MANUAL

  @@map("data_quality_origin")
}

enum GrupoSnapshotOrigin {
  MANUAL
  IMPORTACAO
  INTEGRACAO_FUTURA
  PROCESSAMENTO_INTERNO

  @@map("grupo_snapshot_origin")
}

enum IntegrationConnectorType {
  MOCK
  REST_API
  SOAP
  SFTP
  FILE_PULL
  WEBHOOK
  MANUAL_IMPORT
  FIXTURE
}

enum IntegrationStatus {
  NAO_CONFIGURADA
  ATIVA
  PAUSADA
  ERRO
  DESABILITADA

  @@map("integration_status")
}

enum IntegrationRunStatus {
  PENDENTE
  EXECUTANDO
  SUCESSO
  SUCESSO_PARCIAL
  FALHA
  CANCELADA

  @@map("integration_run_status")
}

enum IntegrationTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  RETRY
  SYSTEM

  @@map("integration_trigger")
}

enum IntegrationEntityType {
  ADMINISTRADORA
  PRODUTO
  GRUPO
  COTA
  ASSEMBLEIA
  LANCE
  CONTEMPLACAO
  TABELA_COMERCIAL
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  GESTOR
  VENDEDOR
  OPERADOR

  @@map("user_role")
}

enum LeadOrigin {
  SIMULADOR_PUBLICO
  CADASTRO_MANUAL
  WHATSAPP
  INDICACAO
  OUTRO

  @@map("lead_origin")
}

enum LeadStatus {
  NOVO
  EM_ATENDIMENTO
  CONTATO_REALIZADO
  QUALIFICADO
  PROPOSTA
  NEGOCIACAO
  CONVERTIDO
  PERDIDO

  @@map("lead_status")
}

enum LeadLossReason {
  SEM_INTERESSE
  SEM_RETORNO
  VALOR_INCOMPATIVEL
  PARCELA_INCOMPATIVEL
  PRAZO_INCOMPATIVEL
  ESCOLHEU_CONCORRENTE
  ADIADO
  OUTRO

  @@map("lead_loss_reason")
}

enum LeadInteractionType {
  NOTA
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  STATUS
  OUTRO

  @@map("lead_interaction_type")
}

enum SimulationCreditMode {
  CONTRACTED_CREDIT
  NET_CREDIT
  CATEGORY_VALUE

  @@map("simulation_credit_mode")
}

enum EmbeddedBidBasis {
  CONTRACTED_CREDIT
  PLAN_TOTAL

  @@map("embedded_bid_basis")
}

enum BidType {
  FIXED
  FREE
  PERCENTUAL

  @@map("bid_type")
}

enum SimulationStatus {
  DRAFT
  CALCULATED
  ARCHIVED

  @@map("simulation_status")
}

enum SimulationCalculationStatus {
  COMPLETE
  INCOMPLETE_DATA
  INELIGIBLE

  @@map("simulation_calculation_status")
}

enum SimulationFavoriteType {
  ADMINISTRATOR
  PRODUCT
  SIMULATION

  @@map("simulation_favorite_type")
}

enum ProposalStatus {
  DRAFT
  GENERATED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("proposal_status")
}

enum CommercialRoundingMode {
  HALF_UP
  UP
  DOWN

  @@map("commercial_rounding_mode")
}

model User {
  teamId                String?                 @map("team_id") @db.Uuid
  team                  Team?                   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  managedTeams          Team[]                  @relation("TeamManager")
  permissionOverrides   UserPermissionOverride[]
  sellerProfile         SellerProfile?
  id                    String                  @id @default(uuid()) @db.Uuid
  nome                  String                  @db.VarChar(200)
  email                 String                  @unique @db.VarChar(254)
  passwordHash          String                  @map("password_hash") @db.VarChar(255)
  role                  UserRole
  ativo                 Boolean                 @default(true)
  telefoneWhatsapp      String?                 @map("telefone_whatsapp") @db.VarChar(30)
  fotoUrl               String?                 @map("foto_url") @db.VarChar(2048)
  interfacePreferences  Json?                   @map("interface_preferences") @db.JsonB
  emailManaged          Boolean                 @default(true) @map("email_managed")
  emailVerificadoEm     DateTime?               @map("email_verificado_em") @db.Timestamptz(3)
  ultimoLoginEm         DateTime?               @map("ultimo_login_em") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  importacoes           Importacao[]
  qualityIssuesResolved DataQualityIssue[]      @relation("DataQualityResolvedBy")
  grupoSnapshotsCreated GrupoHistorico[]        @relation("GrupoSnapshotCreatedBy")
  leadsResponsavel      Lead[]                  @relation("LeadResponsible")
  leadInteractions      LeadInteracao[]         @relation("LeadInteractionCreatedBy")
  followUpsAssigned     FollowUp[]              @relation("FollowUpAssigned")
  followUpsCreated      FollowUp[]              @relation("FollowUpCreatedBy")
  simulations           Simulation[]
  simulationFavorites   SimulationFavorite[]
  proposals             Proposal[]
  proposalStatusChanges ProposalStatusHistory[]
  salesResponsavel      Sale[]                  @relation("SaleResponsible")
  salesCreated          Sale[]                  @relation("SaleCreatedBy")
  saleStatusChanges     SaleStatusHistory[]
  knowledgeDocuments    KnowledgeDocument[]     @relation("KnowledgeDocumentOwner")

  @@index([role, ativo])
  @@index([teamId])
  @@index([ativo])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent") @db.Text
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model Administradora {
  id                  String                  @id @default(uuid()) @db.Uuid
  nome                String                  @db.VarChar(200)
  nomeFantasia        String?                 @map("nome_fantasia") @db.VarChar(200)
  cnpj                String?                 @unique @db.VarChar(14)
  codigoExterno       String?                 @map("codigo_externo") @db.VarChar(100)
  site                String?                 @db.VarChar(2048)
  ativa               Boolean                 @default(true)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  produtos            Produto[]
  grupos              Grupo[]
  fontesDados         FonteDados[]
  integracoes         Integration[]
  tabelasComerciais   TabelaComercial[]
  commercialRules     ProductCommercialRule[]
  simulationResults   SimulationResult[]
  simulationFavorites SimulationFavorite[]
  sales               Sale[]
  commissions         Commission[]
  commissionRules     CommissionRule[]

  @@index([nome])
  @@index([ativa])
  @@index([codigoExterno])
  @@map("administradoras")
}

model Produto {
  id                  String                  @id @default(uuid()) @db.Uuid
  administradoraId    String                  @map("administradora_id") @db.Uuid
  nome                String                  @db.VarChar(200)
  categoria           String                  @db.VarChar(80)
  descricao           String?                 @db.Text
  ativo               Boolean                 @default(true)
  codigoExterno       String?                 @map("codigo_externo") @db.VarChar(100)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  administradora      Administradora          @relation(fields: [administradoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grupos              Grupo[]
  tabelasComerciais   TabelaComercial[]
  commercialRules     ProductCommercialRule[]
  simulationResults   SimulationResult[]
  simulationFavorites SimulationFavorite[]
  sales               Sale[]
  commissionRules     CommissionRule[]

  @@index([administradoraId, ativo])
  @@index([administradoraId, categoria])
  @@index([administradoraId, codigoExterno])
  @@map("produtos")
}

model TabelaComercial {
  id                          String                @id @default(uuid()) @db.Uuid
  administradoraId            String                @map("administradora_id") @db.Uuid
  produtoId                   String?               @map("produto_id") @db.Uuid
  nome                        String                @db.VarChar(200)
  codigo                      String                @db.VarChar(100)
  categoria                   String                @db.VarChar(80)
  inicioVigencia              DateTime              @map("inicio_vigencia") @db.Date
  fimVigencia                 DateTime?             @map("fim_vigencia") @db.Date
  status                      TabelaComercialStatus @default(ATIVA)
  descricao                   String?               @db.Text
  origem                      TabelaComercialOrigem @default(MANUAL)
  indiceCorrecao              String?               @map("indice_correcao") @db.VarChar(100)
  regraSeguro                 String?               @map("regra_seguro") @db.Text
  regraContemplacao           String?               @map("regra_contemplacao") @db.Text
  lanceFacilitado             Boolean?              @map("lance_facilitado")
  cartaoCredito               Boolean?              @map("cartao_credito")
  descricaoBem                String?               @map("descricao_bem") @db.Text
  fundoReservaPercentual      Decimal?              @map("fundo_reserva_percentual") @db.Decimal(9, 6)
  taxaAdministracaoPercentual Decimal?              @map("taxa_administracao_percentual") @db.Decimal(9, 6)
  taxaTotalPercentual         Decimal?              @map("taxa_total_percentual") @db.Decimal(9, 6)
  seguroVidaPercentual        Decimal?              @map("seguro_vida_percentual") @db.Decimal(9, 6)
  participantesGrupo          Int?                  @map("participantes_grupo")
  codigoPlanoNormal           String?               @map("codigo_plano_normal") @db.VarChar(100)
  codigoPlanoMaisPorMenos     String?               @map("codigo_plano_mais_por_menos") @db.VarChar(100)
  metadata                    Json?                 @db.JsonB
  deletedAt                   DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  administradora              Administradora        @relation(fields: [administradoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  produto                     Produto?              @relation(fields: [produtoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  itens                       TabelaComercialItem[]

  @@unique([administradoraId, codigo, inicioVigencia])
  @@index([deletedAt, administradoraId, status, inicioVigencia])
  @@index([produtoId, status])
  @@index([categoria, status])
  @@index([codigo])
  @@map("tabelas_comerciais")
}

model TabelaComercialItem {
  id                          String              @id @default(uuid()) @db.Uuid
  tabelaComercialId           String              @map("tabela_comercial_id") @db.Uuid
  codigoExterno               String?             @map("codigo_externo") @db.VarChar(100)
  creditoReferencia           Decimal             @map("credito_referencia") @db.Decimal(19, 2)
  seguro                      Decimal?            @db.Decimal(19, 2)
  taxaAntecipadaValor         Decimal?            @map("taxa_antecipada_valor") @db.Decimal(19, 2)
  taxaAntecipadaPercentual    Decimal?            @map("taxa_antecipada_percentual") @db.Decimal(9, 6)
  prazoMeses                  Int                 @map("prazo_meses")
  modalidade                  ModalidadeComercial
  primeiraParcela             Decimal?            @map("primeira_parcela") @db.Decimal(19, 2)
  demaisParcelas              Decimal?            @map("demais_parcelas") @db.Decimal(19, 2)
  parcelaPadrao               Decimal?            @map("parcela_padrao") @db.Decimal(19, 2)
  fundoReservaPercentual      Decimal?            @map("fundo_reserva_percentual") @db.Decimal(9, 6)
  taxaAdministracaoPercentual Decimal?            @map("taxa_administracao_percentual") @db.Decimal(9, 6)
  taxaTotalPercentual         Decimal?            @map("taxa_total_percentual") @db.Decimal(9, 6)
  seguroVidaPercentual        Decimal?            @map("seguro_vida_percentual") @db.Decimal(9, 6)
  participantesGrupo          Int?                @map("participantes_grupo")
  codigoPlano                 String?             @map("codigo_plano") @db.VarChar(100)
  metadata                    Json?               @db.JsonB
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tabelaComercial             TabelaComercial     @relation(fields: [tabelaComercialId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tabelaComercialId, creditoReferencia, prazoMeses, modalidade, codigoPlano])
  @@index([tabelaComercialId, modalidade, prazoMeses])
  @@index([codigoExterno])
  @@map("tabelas_comerciais_itens")
}

model Grupo {
  id                 String             @id @default(uuid()) @db.Uuid
  administradoraId   String             @map("administradora_id") @db.Uuid
  produtoId          String?            @map("produto_id") @db.Uuid
  codigo             String             @db.VarChar(100)
  status             String             @db.VarChar(80)
  dataInicio         DateTime?          @map("data_inicio") @db.Date
  dataEncerramento   DateTime?          @map("data_encerramento") @db.Date
  prazoMeses         Int?               @map("prazo_meses")
  quantidadeCotas    Int?               @map("quantidade_cotas")
  valorCreditoMinimo Decimal?           @map("valor_credito_minimo") @db.Decimal(19, 2)
  valorCreditoMaximo Decimal?           @map("valor_credito_maximo") @db.Decimal(19, 2)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  administradora     Administradora     @relation(fields: [administradoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  produto            Produto?           @relation(fields: [produtoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cotas              Cota[]
  assembleias        Assembleia[]
  historicos         GrupoHistorico[]
  leadInteresses     LeadInteresse[]
  simulationResults  SimulationResult[]
  sales              Sale[]

  @@unique([administradoraId, codigo])
  @@index([administradoraId, status])
  @@index([produtoId])
  @@map("grupos")
}

model Cota {
  id                String             @id @default(uuid()) @db.Uuid
  grupoId           String             @map("grupo_id") @db.Uuid
  numero            String             @db.VarChar(50)
  status            String             @db.VarChar(80)
  valorCredito      Decimal?           @map("valor_credito") @db.Decimal(19, 2)
  prazoRestante     Int?               @map("prazo_restante")
  parcelaAtual      Decimal?           @map("parcela_atual") @db.Decimal(19, 2)
  codigoExterno     String?            @map("codigo_externo") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  grupo             Grupo              @relation(fields: [grupoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lances            Lance[]
  contemplacoes     Contemplacao[]
  simulationResults SimulationResult[]
  sales             Sale[]

  @@unique([grupoId, numero])
  @@index([grupoId, status])
  @@index([grupoId, codigoExterno])
  @@map("cotas")
}

model Assembleia {
  id             String         @id @default(uuid()) @db.Uuid
  grupoId        String         @map("grupo_id") @db.Uuid
  numero         String?        @db.VarChar(50)
  dataAssembleia DateTime       @map("data_assembleia") @db.Timestamptz(3)
  status         String         @db.VarChar(80)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  grupo          Grupo          @relation(fields: [grupoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lances         Lance[]
  contemplacoes  Contemplacao[]

  @@unique([grupoId, numero])
  @@index([grupoId, dataAssembleia])
  @@index([status])
  @@map("assembleias")
}

model Lance {
  id           String     @id @default(uuid()) @db.Uuid
  assembleiaId String     @map("assembleia_id") @db.Uuid
  cotaId       String?    @map("cota_id") @db.Uuid
  tipo         String     @db.VarChar(80)
  percentual   Decimal?   @db.Decimal(9, 6)
  valor        Decimal?   @db.Decimal(19, 2)
  contemplado  Boolean?
  origem       String     @db.VarChar(80)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  assembleia   Assembleia @relation(fields: [assembleiaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cota         Cota?      @relation(fields: [cotaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([assembleiaId, tipo])
  @@index([cotaId])
  @@index([contemplado])
  @@map("lances")
}

model Contemplacao {
  id              String     @id @default(uuid()) @db.Uuid
  assembleiaId    String     @map("assembleia_id") @db.Uuid
  cotaId          String?    @map("cota_id") @db.Uuid
  tipo            String     @db.VarChar(80)
  codigoExterno   String?    @map("codigo_externo") @db.VarChar(100)
  valorLance      Decimal?   @map("valor_lance") @db.Decimal(19, 2)
  percentualLance Decimal?   @map("percentual_lance") @db.Decimal(9, 6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  assembleia      Assembleia @relation(fields: [assembleiaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cota            Cota?      @relation(fields: [cotaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([assembleiaId, codigoExterno])
  @@index([assembleiaId, tipo])
  @@index([cotaId])
  @@map("contemplacoes")
}

model GrupoHistorico {
  id                                String              @id @default(uuid()) @db.Uuid
  grupoId                           String              @map("grupo_id") @db.Uuid
  dataReferencia                    DateTime            @map("data_referencia") @db.Timestamptz(3)
  origem                            GrupoSnapshotOrigin @default(MANUAL)
  criadoPorId                       String?             @map("criado_por_id") @db.Uuid
  fonteDadosId                      String?             @map("fonte_dados_id") @db.Uuid
  importacaoId                      String?             @map("importacao_id") @db.Uuid
  idempotencyKey                    String?             @map("idempotency_key") @db.Uuid
  status                            String?             @db.VarChar(80)
  prazoMeses                        Int?                @map("prazo_meses")
  quantidadeCotasDeclarada          Int?                @map("quantidade_cotas_declarada")
  quantidadeCotasRegistradas        Int?                @map("quantidade_cotas_registradas")
  quantidadeParticipantes           Int?                @map("quantidade_participantes")
  quantidadeCotasAtivas             Int?                @map("quantidade_cotas_ativas")
  valorCreditoMinimo                Decimal?            @map("valor_credito_minimo") @db.Decimal(19, 2)
  valorCreditoMaximo                Decimal?            @map("valor_credito_maximo") @db.Decimal(19, 2)
  parcelaMedia                      Decimal?            @map("parcela_media") @db.Decimal(19, 2)
  assembleiasRealizadas             Int?                @map("assembleias_realizadas")
  assembleiasComDadosLance          Int?                @map("assembleias_com_dados_lance")
  assembleiasComDadosContemplacao   Int?                @map("assembleias_com_dados_contemplacao")
  lancesRegistrados                 Int?                @map("lances_registrados")
  lancesContemplados                Int?                @map("lances_contemplados")
  contemplacoesRegistradas          Int?                @map("contemplacoes_registradas")
  contemplacoesSorteio              Int?                @map("contemplacoes_sorteio")
  contemplacoesLance                Int?                @map("contemplacoes_lance")
  contemplacoesOutras               Int?                @map("contemplacoes_outras")
  percentualLanceContempladoMinimo  Decimal?            @map("percentual_lance_contemplado_minimo") @db.Decimal(9, 6)
  percentualLanceContempladoMaximo  Decimal?            @map("percentual_lance_contemplado_maximo") @db.Decimal(9, 6)
  percentualLanceContempladoMedio   Decimal?            @map("percentual_lance_contemplado_medio") @db.Decimal(9, 6)
  percentualLanceContempladoMediano Decimal?            @map("percentual_lance_contemplado_mediano") @db.Decimal(9, 6)
  issuesAbertas                     Int?                @map("issues_abertas")
  issuesCriticas                    Int?                @map("issues_criticas")
  observacoes                       Json?               @db.JsonB
  createdAt                         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  grupo                             Grupo               @relation(fields: [grupoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  criadoPor                         User?               @relation("GrupoSnapshotCreatedBy", fields: [criadoPorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fonteDados                        FonteDados?         @relation(fields: [fonteDadosId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  importacao                        Importacao?         @relation(fields: [importacaoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([grupoId, dataReferencia])
  @@unique([grupoId, idempotencyKey])
  @@index([dataReferencia])
