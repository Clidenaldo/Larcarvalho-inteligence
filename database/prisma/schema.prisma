  validadoEm DateTime? @map("validado_em") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([saleId, tipo])
  @@index([saleId, status])
  @@map("sale_documents")
}

model Commission {
  id String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  administradoraId String? @map("administradora_id") @db.Uuid
  tipo CommissionType @default(PRINCIPAL)
  status CommissionStatus @default(PREVISTA)
  baseCalculo CommissionBase @map("base_calculo")
  baseValor Decimal @map("base_valor") @db.Decimal(19, 2)
  percentual Decimal? @db.Decimal(9, 6)
  valorPrevisto Decimal @map("valor_previsto") @db.Decimal(19, 2)
  valorConfirmado Decimal? @map("valor_confirmado") @db.Decimal(19, 2)
  valorRecebido Decimal @default(0) @map("valor_recebido") @db.Decimal(19, 2)
  competencia String @db.VarChar(7)
  dataPrevistaPagamento DateTime? @map("data_prevista_pagamento") @db.Timestamptz(3)
  dataConfirmacao DateTime? @map("data_confirmacao") @db.Timestamptz(3)
  dataRecebimento DateTime? @map("data_recebimento") @db.Timestamptz(3)
  referenciaExterna String? @map("referencia_externa") @db.VarChar(200)
  observacoes String? @db.VarChar(2000)
  regraSnapshot Json? @map("regra_snapshot") @db.JsonB
  estornoDeId String? @map("estorno_de_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  administradora Administradora? @relation(fields: [administradoraId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  estornoDe Commission? @relation("CommissionReversal", fields: [estornoDeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estornos Commission[] @relation("CommissionReversal")
  @@index([saleId, status])
  @@index([administradoraId, competencia])
  @@index([status, competencia])
  @@map("commissions")
}

model CommissionRule {
  id String @id @default(uuid()) @db.Uuid
  administradoraId String @map("administradora_id") @db.Uuid
  produtoId String? @map("produto_id") @db.Uuid
  categoria String? @db.VarChar(80)
  tipoBase CommissionBase @map("tipo_base")
  percentual Decimal? @db.Decimal(9, 6)
  valorFixo Decimal? @map("valor_fixo") @db.Decimal(19, 2)
  vigenciaInicio DateTime @map("vigencia_inicio") @db.Date
  vigenciaFim DateTime? @map("vigencia_fim") @db.Date
  ativo Boolean @default(true)
  prioridade Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  administradora Administradora @relation(fields: [administradoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  @@index([administradoraId, ativo])
  @@map("commission_rules")
}

model SaleSequence {
  year Int @id
  lastNumber Int @default(0) @map("last_number")
  @@map("sale_sequences")
}

// ---------------------------------------------------------------------------
// Fase 28 — Base de Conhecimento (RAG)
// ---------------------------------------------------------------------------

enum KnowledgeCategory {
  MANUAL
  REGULAMENTO
  TABELA
  PROCEDIMENTO
  PRODUTO
  COMERCIAL
  INSTITUCIONAL
  OUTRO
  @@map("knowledge_category")
}

enum KnowledgeVisibility {
  PUBLIC
  TEAM
  PRIVATE
  @@map("knowledge_visibility")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
  ARCHIVED
  @@map("knowledge_document_status")
}

enum KnowledgeSourceType {
  MANUAL
  UPLOAD
  @@map("knowledge_source_type")
}

enum KnowledgeIngestionStatus {
  PENDING
  EXTRACTING
  CHUNKING
  READY
  FAILED
  @@map("knowledge_ingestion_status")
}

enum KnowledgeEmbeddingStatus {
  NONE
  PENDING
  READY
  FAILED
  @@map("knowledge_embedding_status")
}

model KnowledgeDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  title           String                  @db.VarChar(300)
  description     String?                 @db.VarChar(2000)
  category        KnowledgeCategory       @default(OUTRO)
  visibility      KnowledgeVisibility     @default(PUBLIC)
  status          KnowledgeDocumentStatus @default(PROCESSING)
  sourceType      KnowledgeSourceType     @default(MANUAL) @map("source_type")
  originalName    String?                 @map("original_name") @db.VarChar(300)
  mimeType        String?                 @map("mime_type") @db.VarChar(200)
  sizeBytes       Int                     @default(0) @map("size_bytes")
  checksum        String?                 @db.VarChar(128)
  storageKey      String?                 @map("storage_key") @db.VarChar(600)
  contentText     String?                 @map("content_text") @db.Text
  ownerUserId     String?                 @map("owner_user_id") @db.Uuid
  teamId          String?                 @map("team_id") @db.Uuid
  version         Int                     @default(1)
  documentGroupId String                  @map("document_group_id") @db.Uuid
  tags            String[]                @default([])
  chunkCount      Int                     @default(0) @map("chunk_count")
  failureReason   String?                 @map("failure_reason") @db.VarChar(500)
  processedAt     DateTime?               @map("processed_at") @db.Timestamptz(3)
  embeddingStatus KnowledgeEmbeddingStatus @default(NONE) @map("embedding_status")
  embeddingProvider String?               @map("embedding_provider") @db.VarChar(40)
  embeddingModel  String?                 @map("embedding_model") @db.VarChar(120)
  embeddingVersion String?                @map("embedding_version") @db.VarChar(40)
  embeddedAt      DateTime?               @map("embedded_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           User?                   @relation("KnowledgeDocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team            Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  chunks          KnowledgeChunk[]
  ingestions      KnowledgeIngestion[]
  @@index([checksum])
  @@index([status, category])
  @@index([visibility, teamId])
  @@index([ownerUserId])
  @@index([documentGroupId, version])
  @@index([category, createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String            @id @default(uuid()) @db.Uuid
  documentId  String            @map("document_id") @db.Uuid
  ordinal     Int
  content     String            @db.Text
  contentHash String            @map("content_hash") @db.Char(64)
  tokens      Int               @default(0)
  section     String?           @db.VarChar(300)
  page        Int?
  embeddingStatus KnowledgeEmbeddingStatus @default(NONE) @map("embedding_status")
  embeddingModel String?          @map("embedding_model") @db.VarChar(120)
  embeddingVersion String?        @map("embedding_version") @db.VarChar(40)
  embeddedAt   DateTime?         @map("embedded_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model KnowledgeIngestion {
  id            String                   @id @default(uuid()) @db.Uuid
  documentId    String                   @map("document_id") @db.Uuid
  status        KnowledgeIngestionStatus @default(PENDING)
  chunksCreated Int                      @default(0) @map("chunks_created")
  error         String?                  @db.VarChar(500)
  startedAt     DateTime?                @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?                @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  document      KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([documentId, createdAt])
  @@map("knowledge_ingestions")
}

// ---------------------------------------------------------------------------
// Fase 29 — IA real de produção: telemetria de uso e precificação
// ---------------------------------------------------------------------------

model AiUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  provider      String   @db.VarChar(20)
  model         String   @db.VarChar(120)
  contextType   String   @map("context_type") @db.VarChar(40)
  promptId      String?  @map("prompt_id") @db.VarChar(60)
  promptVersion String?  @map("prompt_version") @db.VarChar(20)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  totalTokens   Int?     @map("total_tokens")
  estimated     Boolean  @default(false)
  costMicros    BigInt?  @map("cost_micros")
  currency      String?  @db.VarChar(8)
  latencyMs     Int      @map("latency_ms")
  status        String   @db.VarChar(20)
  errorCode     String?  @map("error_code") @db.VarChar(80)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

model AiPricing {
  id                     String   @id @default(uuid()) @db.Uuid
  provider               String   @db.VarChar(20)
  model                  String   @db.VarChar(120)
  currency               String   @db.VarChar(8)
  inputPerMillionMicros  BigInt   @map("input_per_million_micros")
  outputPerMillionMicros BigInt   @map("output_per_million_micros")
  cachedPerMillionMicros BigInt?  @map("cached_per_million_micros")
  validFrom              DateTime @map("valid_from") @db.Timestamptz(3)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([provider, model])
  @@map("ai_pricing")
}

// ---------------------------------------------------------------------------
// Fase 30 — Hub de integrações: segredos, staging, webhooks
// ---------------------------------------------------------------------------

model IntegrationSecret {
  id            String      @id @default(uuid()) @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  keyName       String      @default("default") @map("key_name") @db.VarChar(80)
  ciphertext    String      @db.Text
  iv            String      @db.VarChar(64)
  authTag       String      @map("auth_tag") @db.VarChar(64)
  keyVersion    String      @default("1") @map("key_version") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  rotatedAt     DateTime?   @map("rotated_at") @db.Timestamptz(3)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([integrationId, keyName])
  @@index([integrationId])
  @@map("integration_secrets")
}

model IntegrationStagingRecord {
  id            String      @id @default(uuid()) @db.Uuid
  runId         String      @map("run_id") @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  externalId    String      @map("external_id") @db.VarChar(255)
  entityType    String      @map("entity_type") @db.VarChar(40)
  checksum      String      @db.VarChar(64)
  payload       Json        @db.JsonB
  schemaVersion String      @default("CANONICAL_V1") @map("schema_version") @db.VarChar(40)
  status        String      @default("PENDING") @db.VarChar(20)
  errorCode     String?     @map("error_code") @db.VarChar(100)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  run           IntegrationRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([runId, entityType, externalId])
  @@index([runId])
  @@map("integration_staging_records")
}

model IntegrationWebhookEvent {
  id            String      @id @default(uuid()) @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  eventId       String      @map("event_id") @db.VarChar(200)
  checksum      String      @db.VarChar(64)
  payload       Json        @db.JsonB
  status        String      @default("RECEIVED") @db.VarChar(20)
  receivedAt    DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([integrationId, eventId])
  @@index([integrationId])
  @@map("integration_webhook_events")
}
