# Aplicações
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_TIMEOUT_MS=3000
LOG_LEVEL=info
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=10000
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_SESSION_TTL_HOURS=12
PUBLIC_SIMULATOR_CANDIDATE_LIMIT=100
PUBLIC_SIMULATOR_RATE_LIMIT_MAX=30
PUBLIC_SIMULATOR_RATE_LIMIT_WINDOW_MS=600000
PUBLIC_SIMULATOR_TIMEOUT_MS=5000
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_PRIVACY_POLICY_URL=
PUBLIC_LEAD_RATE_LIMIT_MAX=10
PUBLIC_LEAD_RATE_LIMIT_WINDOW_MS=600000
INTEGRATION_REST_ALLOWED_HOSTS=
TRUST_PROXY_HOPS=0

# IA — provedor (segredos somente no .env local, nunca no Git)
# mock = simulado (padrão, sem rede/custo); external = HTTP compatível OpenAI
AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=larcarvalho-copilot-v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_ALLOWED_MODELS=
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=15000
AI_RESOURCES=commercial_copilot,lead_analysis,simulation_explain,comparison_analysis,draft_messages,manager_summary,knowledge_grounded_answer
AI_STREAMING_ENABLED=true
AI_FALLBACK_PROVIDER=none
# Embeddings / retrieval (none = FTS lexical; sem pgvector, semantic/hybrid indisponíveis)
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=
AI_RETRIEVAL_MODE=lexical
AI_TOP_K=5
AI_RRF_K=60
# Limites (vazio = sem limite); micros = milionésimos da moeda
AI_DAILY_TOKEN_LIMIT=
AI_DAILY_COST_LIMIT_MICROS=
AI_MONTHLY_COST_LIMIT_MICROS=
AI_MAX_TOKENS_PER_REQUEST=
AI_CONTEXT_RESERVE_TOKENS=1000
# Testes live do provider real (gated, fora do check; exige AI_API_KEY real)
AI_LIVE_TESTS=false

# PostgreSQL (substituir placeholders somente no .env local)
POSTGRES_DB=larcarvalho
POSTGRES_USER=larcarvalho
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_test?schema=public
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_POOL_MAX=10

# Produção / proxy
APP_DOMAIN=
